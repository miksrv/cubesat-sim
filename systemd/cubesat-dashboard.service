# The local dashboard: read-only REST over the database plus the static React
# build deployed from cubesat-groundstation. Browsers get their live data from
# mosquitto's own WebSocket listener, not from this service.
#
# Separate from the template because it binds a port and reads the database
# read-only, and because HOSTD starts it only in profiles that ask for it.

[Unit]
Description=CubeSat local dashboard
After=network.target mosquitto.service
Wants=mosquitto.service
PartOf=cubesat.target

[Service]
Type=simple
User=cubesat
Group=cubesat
WorkingDirectory=/opt/cubesat-sim
ExecStart=/opt/cubesat-sim/venv/bin/python -m cubesat.dashboard
Restart=always
RestartSec=5

# As in cubesat@.service: the runtime directories come from
# config/tmpfiles.d/cubesat.conf so that ownership does not follow whichever
# unit restarted last, and ReadWritePaths re-opens them under ProtectSystem.
# /var/lib/cubesat/dashboard is where scripts/deploy-dashboard.sh rsyncs the
# built interface; this service only ever reads it.
ReadWritePaths=/var/lib/cubesat /var/log/cubesat /run/cubesat

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
