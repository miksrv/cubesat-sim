# The only unit in this project that runs as root.
#
# HOSTD holds no decision logic: it executes a fixed vocabulary of actions on an
# explicit allowlist and reports what it actually achieved. Everything that
# decides runs unprivileged, in cubesat@obc.
#
# It must never stop cubesat@obc or mosquitto — that is the branch it is sitting
# on — and OBC must never stop it. Both are enforced in code, not here.

[Unit]
Description=CubeSat host executor (profiles, network, power)
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/cubesat-sim
ExecStart=/opt/cubesat-sim/venv/bin/python -m cubesat.hostd
Restart=always
RestartSec=5

# No StateDirectory/RuntimeDirectory/LogsDirectory here, and this is the unit
# that made removing them necessary: being root, its start re-chowned all three
# shared directories — and their contents — to root:root, after which every
# unprivileged service lost write access to the database, the photo tree, its
# own log and the I2C lock. config/tmpfiles.d/cubesat.conf creates them once,
# owned by cubesat; root writes there regardless of who owns them, so this unit
# gives up nothing by not declaring them.

[Install]
WantedBy=multi-user.target
