# Template unit for the identical services: cubesat@obc, cubesat@eps,
# cubesat@adcs, cubesat@payload, cubesat@dhs, cubesat@comms.
#
# One template instead of six near-identical files, because six files drift and
# a template cannot. HOSTD and DASHBOARD are separate units: different
# privileges and different dependencies.
#
#   sudo systemctl enable --now cubesat@obc.service

[Unit]
Description=CubeSat %i subsystem
After=network.target mosquitto.service
Wants=mosquitto.service
PartOf=cubesat.target

[Service]
Type=simple
# A dedicated service account, not a human one: flight software has no business
# running with a person's login, and the checkout lives outside anyone's home so
# that ProtectHome can be absolute below.
User=cubesat
Group=cubesat
# I2C, GPIO and the camera; the serial group is for the Meshtastic node.
SupplementaryGroups=i2c gpio video dialout
WorkingDirectory=/opt/cubesat-sim
ExecStart=/opt/cubesat-sim/venv/bin/python -m cubesat.%i
Restart=always
RestartSec=5

# lgpio drops a notification FIFO (.lgd-nfy*) into its working directory unless
# LG_WD names somewhere else — and the working directory here is a checkout the
# service may not write. Without this, EPS logs "xCreatePipe: Can't set
# permissions ... Read-only file system" and only keeps working while an old
# FIFO happens to survive from an earlier run; delete that file and the PLD pin
# stops being readable, taking external_power — and with it the whole
# suppression of the power-driven descents — down with it.
Environment=LG_WD=/run/cubesat

# The three runtime directories are created by config/tmpfiles.d/cubesat.conf,
# NOT by StateDirectory/LogsDirectory/RuntimeDirectory. Those re-chown the tree
# to the starting unit's own User on every start, and cubesat-hostd is root over
# the same paths — so ownership followed whoever restarted last. The file there
# carries the full account. ReadWritePaths is what re-opens them for writing
# under ProtectSystem=strict.
ReadWritePaths=/var/lib/cubesat /var/log/cubesat /run/cubesat

# Unprivileged: only HOSTD may touch the host.
NoNewPrivileges=yes
ProtectSystem=strict
# Absolute rather than read-only: nothing this service needs lives in a home
# directory any more, so there is no reason for it to see one.
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
